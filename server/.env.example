# Runtime
NODE_ENV=development
PORT=5000

# Database and authentication
MONGODB_URI=mongodb://127.0.0.1:27017/coparent?replicaSet=rs0
JWT_SECRET=replace-with-at-least-64-random-characters

# Exact frontend origin; do not include a trailing slash
CLIENT_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP (Gmail production example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=Co-Parenting Coordinator <your-sender@gmail.com>
